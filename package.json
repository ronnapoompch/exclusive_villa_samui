{
  "name": "exclusive-villa-samui",
  "version": "1.0.0",
  "private": true,
  "description": "Luxury villa booking platform for Koh Samui, Thailand",
  "author": "Exclusive Villa Samui Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:fast": "next dev --turbo",
    "dev:clean": "rimraf .next && next dev --turbo",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} prisma/seed.ts",
    "prisma:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u",
    "analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next out dist node_modules/.cache"
  },
